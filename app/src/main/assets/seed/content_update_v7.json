    "quotes":  [
                   {
                       "id":  "arsaningsih_066",
                       "text":  "Proses terhubung dengan Tuhan adalah bentuk channeling tertinggi yang harus kita tuju, bukan terikat pada spirit-spirit yang lebih rendah.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "channeling,kesadaran,tuhan,spiritual",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  10
                   },
                   {
                       "id":  "arsaningsih_067",
                       "text":  "Tubuh manusia adalah tempat suci (istana batin); hanya energi, cahaya, dan kekuatan Tuhan yang layak memasukinya.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "tubuh suci,istana batin,energi,cahaya",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  10
                   },
                   {
                       "id":  "arsaningsih_068",
                       "text":  "Hukum energi bekerja secara pasti: sejenis menarik sejenis. Frekuensi pikiran, emosi, dan kesadaran kita menentukan apa yang hadir dalam kehidupan.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "hukum energi,frekuensi,pikiran,kesadaran",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  10
                   },
                   {
                       "id":  "arsaningsih_069",
                       "text":  "Kebersihan hati dan kebeningan batin adalah kunci utama untuk menterjemahkan pesan-pesan kebenaran tanpa terkontaminasi oleh ego.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "mindfulness",
                       "tags":  "kebersihan hati,batin hening,ego,kebenaran",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_070",
                       "text":  "Setiap satu langkah kita meniatkan diri menuju kepada Tuhan, Tuhan akan melangkah seribu langkah mendekati diri kita.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "gratitude",
                       "tags":  "niat suci,kepasrahan,kasih tuhan,spiritual",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_071",
                       "text":  "Jangan pernah bangga dengan keajaiban atau fenomena semu yang mengotori tubuh energi, karena di balik euforia ego ada penderitaan jiwa.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "inner_peace",
                       "tags":  "ego,pemurnian,tubuh energi,kebijaksanaan",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  8
                   },
                   {
                       "id":  "arsaningsih_072",
                       "text":  "Menjadikan diri sebagai saluran Sabda dan Berkat Ilahi membutuhkan pemurnian batin serta kerendahan hati yang mendalam.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "saluran berkat,pemurnian batin,kerendahan hati",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  10
                   },
                   {
                       "id":  "arsaningsih_073",
                       "text":  "Transformasi jiwa yang sejati terjadi saat kita mampu melunakkan ego dan menyelaraskan kehendak diri dengan kehendak Ilahi.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "inner_peace",
                       "tags":  "transformasi jiwa,melunakkan ego,keselarasan",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_074",
                       "text":  "Evolusi jiwa adalah perjalanan panjang untuk melepas selapis demi selapis kegelapan batin demi kembali menuju Cahaya Sang Pencipta.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "evolusi jiwa,cahaya,pelepasan,sang pencipta",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_075",
                       "text":  "Mendua dalam kepasrahan spiritual hanya akan memperlama putaran reinkarnasi dan menunda perjalanan kita untuk kembali pulang.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "kepasrahan,reinkarnasi,pulang,spiritual",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_076",
                       "text":  "Setiap informasi di alam terekam secara rapi dalam energi; hanya batin yang netral yang mampu membaca kebenaran apa adanya.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "mindfulness",
                       "tags":  "rekaman energi,batin netral,kebenaran,kesadaran",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_077",
                       "text":  "Kelembutan dalam bertindak dan berkata-kata lahir saat energi kasih Tuhan mengalir dan mengikis karakter keras di dalam diri.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "inner_peace",
                       "tags":  "kelembutan,energi kasih,karakter,kedamaian",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  8
                   },
                   {
                       "id":  "arsaningsih_078",
                       "text":  "Bukan seberapa sakti atau hebat kita di mata manusia, melainkan seberapa murni batin dan kesadaran kita di hadapan Tuhan.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "kemurnian batin,kesadaran,kerendahan hati",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  10
                   },
                   {
                       "id":  "arsaningsih_079",
                       "text":  "Pengalaman dan kekeliruan di masa lalu adalah pelajaran berharga untuk mendewasakan jiwa dan mengarahkan kembali ke jalan yang benar.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "stoicism",
                       "tags":  "pembelajaran,kedewasaan jiwa,pengalaman",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  8
                   },
                   {
                       "id":  "arsaningsih_080",
                       "text":  "Jiwa yang tenang lahir dari kesadaran bahwa kebenaran dan hukum Tuhan adalah satu-satunya pegangan sejati dalam hidup.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "inner_peace",
                       "tags":  "jiwa tenang,hukum tuhan,kebenaran,kedamaian",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_081",
                       "text":  "Memberikan pertolongan spiritual harus didasari oleh kebijaksanaan murni, bukan oleh euforia ego untuk dipuji dan diakui.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "mindfulness",
                       "tags":  "kebijaksanaan,pelayanan tulus,ego,kesadaran",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  8
                   },
                   {
                       "id":  "arsaningsih_082",
                       "text":  "Membuat tempat suci di dalam diri berarti menjaga kesucian jiwa dari segala kontaminasi energi kotor dan niat buruk.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "kesucian jiwa,energi bersih,niat baik",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_083",
                       "text":  "Jangan biarkan pemenuhan keinginan fisik atau euforia semata merusak wadah spiritual yang telah Tuhan percayakan pada kita.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "inner_peace",
                       "tags":  "kendali diri,wadah spiritual,kesadaran",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  8
                   },
                   {
                       "id":  "arsaningsih_084",
                       "text":  "Setiap niat bertumbuh yang disertai kerendahan hati akan senantiasa membukakan pintu ilmu pengetahuan tertinggi.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "mindfulness",
                       "tags":  "pertumbuhan jiwa,kerendahan hati,kebijaksanaan",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  8
                   },
                   {
                       "id":  "arsaningsih_085",
                       "text":  "Mengukur dan mengamati diri secara jujur tanpa kebohongan ego adalah awal mula dari pemurnian kesadaran jiwa.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "mindfulness",
                       "tags":  "kejujuran batin,swaperiksa,pemurnian jiwa",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Channeling \u0026 Energi)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_086",
                       "text":  "Anugerah spiritual bukanlah hadiah gratis dari langit, melainkan hasil perjuangan dan tabungan kesadaran jiwa dari kehidupan masa lalu.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "anugerah spiritual,tabungan jiwa,kesadaran",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  10
                   },
                   {
                       "id":  "arsaningsih_087",
                       "text":  "Semua kepekaan dan kemampuan spiritual adalah sarana untuk mengenali diri serta menyelesaikan misi jiwa, bukan untuk dipamerkan.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "kepekaan,mengenal diri,misi jiwa",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  10
                   },
                   {
                       "id":  "arsaningsih_088",
                       "text":  "Kemampuan spiritual tanpa disertai kesadaran dan pemurnian karakter hanya akan menjadi beban berat serta bumerang bagi diri sendiri.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "mindfulness",
                       "tags":  "karakter,kesadaran,pemurnian batin",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_089",
                       "text":  "Jangan terjebak menjadi penyembuh atau pengusada yang sibuk mengurus orang lain hingga lupa menyelesaikan misi jiwanya sendiri.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "stoicism",
                       "tags":  "misi jiwa,fokus diri,keseimbangan",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  8
                   },
                   {
                       "id":  "arsaningsih_090",
                       "text":  "Kepekaan indera spiritual akan membawa kedamaian sejati saat digunakan untuk mengikis karakter buruk dan memperluas cinta kasih.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "inner_peace",
                       "tags":  "cinta kasih,kedamaian,mengikis ego",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_091",
                       "text":  "Jiwa yang tersucikan di mata Tuhan otomatis memiliki perlindungan Ilahi, tanpa perlu mengejar kesaktian atau kehebatan duniawi.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "perlindungan ilahi,kesucian batin,kepasrahan",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  10
                   },
                   {
                       "id":  "arsaningsih_092",
                       "text":  "Kesombongan atas kemampuan spiritual adalah awal dari kejatuhan jiwa yang sangat dalam.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "mindfulness",
                       "tags":  "kerendahan hati,waspada ego,kesombongan",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_093",
                       "text":  "Setiap manusia diciptakan dengan potensi kepekaan energi; tugas kita adalah melatihnya dalam kemurnian niat dan kerendahan hati.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "kepekaan energi,niat murni,latihan batin",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_094",
                       "text":  "Memperluas realita berarti mau membuka batin untuk memahami hukum energi serta kebenaran Tuhan yang tak terbatas.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "mindfulness",
                       "tags":  "membuka batin,hukum energi,kebenaran ilahi",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  8
                   },
                   {
                       "id":  "arsaningsih_095",
                       "text":  "Kehidupan saat ini adalah kesempatan emas untuk melanjutkan pencapaian tabungan kesadaran spiritual dari masa lalu.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "gratitude",
                       "tags":  "kesempatan hidup,tabungan kesadaran,pertumbuhan",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_096",
                       "text":  "Bukan tempat luar yang memberi perlindungan sejati, melainkan pancaran cinta kasih dan pemurnian di dalam rumah batin kita.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "inner_peace",
                       "tags":  "rumah batin,pancaran kasih,perlindungan",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_097",
                       "text":  "Intuisi yang jernih dan objektif lahir ketika batin kita terbebas dari jerat ego, kemarahan, dan keinginan subjektif.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "mindfulness",
                       "tags":  "intuisi jernih,bebas ego,kejernihan batin",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_098",
                       "text":  "Mengakui kekurangan diri, memohon maaf, dan memaafkan adalah cara paling ampuh memurnikan Cakra Jantung.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "gratitude",
                       "tags":  "memaafkan,cakra jantung,pemurnian kasih",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  10
                   },
                   {
                       "id":  "arsaningsih_099",
                       "text":  "Menghadapi radiasi marah atau sedih dari orang lain dengan pancaran kasih adalah wujud nyata kebijaksanaan spiritual.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "inner_peace",
                       "tags":  "pancaran kasih,respon bijak,kedamaian",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_100",
                       "text":  "Setiap jiwa membawa potensi dan potensi dari kehidupan lampau; kembangkanlah itu untuk memurnikan diri dan melayani sesama.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "potensi jiwa,pelayanan tulus,pemurnian",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_101",
                       "text":  "Rasa bersyukur atas capaian jiwa masa lalu harus diwujudkan dengan terus bertumbuh, bukan berdiam di zona nyaman.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "gratitude",
                       "tags":  "rasa syukur,terus bertumbuh,kesadaran",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  8
                   },
                   {
                       "id":  "arsaningsih_102",
                       "text":  "Ketika kita berupaya memurnikan batin, cahaya dan kasih Tuhan akan turun membersihkan segala kegelapan serta kebingungan.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "cahaya ilahi,pembersihan batin,kasih tuhan",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  10
                   },
                   {
                       "id":  "arsaningsih_103",
                       "text":  "Orang yang bijak memanfaatkan kepekaannya sebagai kompas penunjuk untuk membenahi karakter buruk dan melangkah lebih murni.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "mindfulness",
                       "tags":  "kompas batin,benahi karakter,kemurnian",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  8
                   },
                   {
                       "id":  "arsaningsih_104",
                       "text":  "Menyelesaikan ikatan karma masa lalu membutuhkan ikhlas, kepasrahan total, serta pengampunan yang tulus.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "inner_peace",
                       "tags":  "ikatan karma,keikhlasan,pengampunan",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_105",
                       "text":  "Mengenali diri secara utuh adalah pintu utama untuk membuka tabir Kebesaran dan Kasih Tuhan Sang Pencipta.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "mengenal diri,kebesaran tuhan,kasih pencipta",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Spiritual Gift)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  10
                   },
                   {
                       "id":  "arsaningsih_106",
                       "text":  "Misi jiwa utama setiap manusia adalah mendewasakan kesadaran, memurnikan ikatan karma, dan kembali menyatu dengan Tuhan.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "misi jiwa,kesadaran,ikatan karma,kembali pulang",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  10
                   },
                   {
                       "id":  "arsaningsih_107",
                       "text":  "Setiap manusia lahir membawa peran dan tugas unik yang merupakan kelanjutan dari pembelajaran kehidupan-kehidupan sebelumnya.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "peran unik,tugas jiwa,pembelajaran hidup",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_108",
                       "text":  "Kegagalan menyelesaikan pelajaran jiwa akan membuat kita terus terlahir kembali hingga proses pembelajaran tersebut genap.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "pelajaran jiwa,reinkarnasi,penyelesaian",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_109",
                       "text":  "Misi jiwa terdekat dan paling nyata adalah menyelesaikan hutang karma dengan orang-orang terdekat di sekitar kita.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "gratitude",
                       "tags":  "hutang karma,orang terdekat,kasih sayang",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_110",
                       "text":  "Keinginan dan ego duniawi sering kali menyesatkan serta memalingkan kita dari jalan misi jiwa yang sesungguhnya.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "stoicism",
                       "tags":  "waspada ego,godaan duniawi,misi sejati",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  8
                   },
                   {
                       "id":  "arsaningsih_111",
                       "text":  "Menerima takdir dan kondisi hidup dengan ikhlas tanpa penolakan adalah langkah awal penyelesaian ikatan karma.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "inner_peace",
                       "tags":  "menerima takdir,keikhlasan,tanpa penolakan",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_112",
                       "text":  "Membayar hutang karma dengan cinta dan kedamaian akan membebaskan jiwa dari belenggu kegelapan dan penderitaan.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "inner_peace",
                       "tags":  "cinta kasih,pembebasan karma,kedamaian",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_113",
                       "text":  "Ciri jiwa yang matang adalah hadirnya kesadaran untuk melayani sesama dengan ikhlas serta kerinduan mendalam kepada Sang Pencipta.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "gratitude",
                       "tags":  "jiwa matang,pelayanan tulus,rindu pencipta",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  10
                   },
                   {
                       "id":  "arsaningsih_114",
                       "text":  "Kerendahan hati untuk mengakui bahwa kita adalah ciptaan yang membutuhkan kekuatan Tuhan adalah kunci utama pembuka cahaya jiwa.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "kerendahan hati,kekuatan tuhan,cahaya jiwa",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  10
                   },
                   {
                       "id":  "arsaningsih_115",
                       "text":  "Tabungan karma baik dan kebajikan memperlancar jalan kita dalam menemukan serta menuntaskan misi jiwa.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "gratitude",
                       "tags":  "karma baik,kebajikan,menuntaskan misi",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_116",
                       "text":  "Saling memaafkan dan memohon maaf dengan tulus dapat memutus rantai konflik karma dari berbagai masa kehidupan.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "inner_peace",
                       "tags":  "saling memaafkan,memutus karma,ketulusan",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_117",
                       "text":  "Multitalenta yang tidak fokus sering kali menandakan jiwa yang belum konsisten menyelesaikan satu misi utama perjalanan hidupnya.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "stoicism",
                       "tags":  "fokus,konsistensi,tujuan hidup",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  8
                   },
                   {
                       "id":  "arsaningsih_118",
                       "text":  "Guru sejati dan petunjuk kebenaran akan hadir tepat pada waktunya saat jiwa kita siap dan berpasrah secara tulus.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "guru sejati,petunjuk kebenaran,kepasrahan",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_119",
                       "text":  "Keberhasilan hidup sejati tidak diukur dari gelar atau harta duniawi, melainkan dari kedamaian dan tingkat pemurnian jiwa.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "inner_peace",
                       "tags":  "keberhasilan sejati,kedamaian,pemurnian jiwa",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_120",
                       "text":  "Segala penderitaan dan hambatan dalam hidup adalah sarana latihan untuk menempa ketangguhan dan mematangkan jiwa.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "courage",
                       "tags":  "ketangguhan,menempa jiwa,pembelajaran hidup",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_121",
                       "text":  "Kehendak bebas manusia menentukan apakah ia memilih untuk naik kelas spiritual atau jatuh kembali karena godaan ego.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "stoicism",
                       "tags":  "kehendak bebas,pilihan jiwa,naik kelas",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  8
                   },
                   {
                       "id":  "arsaningsih_122",
                       "text":  "Melibatkan kekuatan Tuhan dalam setiap langkah hidup adalah cara tercepat mengikis kegelapan dan kekotoran batin.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "kekuatan tuhan,penyucian batin,spiritualitas",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  10
                   },
                   {
                       "id":  "arsaningsih_123",
                       "text":  "Semua ciptaan Tuhan pada akhirnya harus menyadari keesaan-Nya dan berjalan menuju proses kembali pulang.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "keesaan tuhan,kembali pulang,perjalanan jiwa",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_124",
                       "text":  "Pancaran jiwa yang bercahaya terang akan senantiasa menarik kebaikan dan kebenaran yang sejenis di alam semesta.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "jiwa_spiritual",
                       "tags":  "pancaran jiwa,hukum tarik menarik,kebaikan",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  9
                   },
                   {
                       "id":  "arsaningsih_125",
                       "text":  "Selama kita masih bernapas di bumi, gunakan setiap detik untuk berbenah diri, berbuat baik, dan menyempurnakan misi jiwa.",
                       "author":  "Bunda Arsaningsih",
                       "category":  "mindfulness",
                       "tags":  "berbenah diri,berbuat baik,misi jiwa,waktu",
                       "language":  "id",
                       "active":  true,
                       "source":  "Karma, Reinkarnasi \u0026 Misi Jiwa (Misi Jiwa)",
                       "attribution":  "Bunda Arsaningsih",
                       "priority":  10
                   }
